api.pleero.app {
    encode gzip

    reverse_proxy backend:8000 {
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    log {
        output file /data/access.log
        format json
    }

    header {
        X-Content-Type-Options nosniff
        X-XSS-Protection "1; mode=block"
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Content Security Policy (using frame-ancestors for Shopify embedding)
        Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.shopify.com; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self' data:; connect-src 'self' https://api.pleero.app https://api-dev.pleero.app; frame-ancestors 'self' https://admin.shopify.com https://*.myshopify.com; base-uri 'self'; form-action 'self'"

        -Server
    }
}
