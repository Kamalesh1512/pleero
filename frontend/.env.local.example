NEXT_PUBLIC_API_URL=https://api-dev.pleero.app
NEXT_PUBLIC_SHOPIFY_API_KEY=your_shopify_api_key_here
NEXT_PUBLIC_APP_ENV=development

# Google Analytics 4 — leave blank in development to disable tracking
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Note: NEVER put SHOPIFY_API_SECRET in frontend - it's a backend-only secret
# Set NEXT_PUBLIC_APP_ENV=production for production deployment
