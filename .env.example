# PostgreSQL
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Redis
REDIS_PASSWORD=your_secure_redis_password_here

# Shopify App Credentials
# Get these from your Shopify Partner dashboard
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here

# Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_fernet_encryption_key_here

# Resend (for transactional emails)
RESEND_API_KEY=re_your_resend_api_key_here

# Application
APP_ENV=development

# === LOCAL DEVELOPMENT URLs (via Cloudflare Tunnel) ===
# Use these for local development with webhooks:
API_BASE_URL=https://api-dev.pleero.app
FRONTEND_URL=https://dev.pleero.app

# === PRODUCTION URLs ===
# When deploying to production, change to:
# APP_ENV=production
# API_BASE_URL=https://api.pleero.app
# FRONTEND_URL=https://pleero.app
