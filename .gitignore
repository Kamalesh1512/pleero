# Environment variables (real credentials - never commit)
.env
.env.*
*.env
# Allow template/example files only
!.env.example
!.env*.example
!**/.env.example
!**/.env*.example

# Claude Code internal state (never commit)
.claude/

# Markdown files (only commit README.md)
*.md
!README.md

# docs/ folder is internal product documentation — not part of the repo
docs/

